# Java 服务监听端口；容器部署或多实例运行时可按环境覆盖。
GATEWAY_SERVER_PORT=8000
AUTH_SERVER_PORT=8100
USER_SERVER_PORT=8200
CONTENT_SERVER_PORT=8300
AUDIT_SERVER_PORT=8400
INTERACTION_SERVER_PORT=8500
RECOMMEND_SERVER_PORT=8600
FILE_SERVER_PORT=8700
TRANSCODE_SERVER_PORT=8800

# Nacos
NACOS_SERVER_ADDR=localhost:8848
NACOS_SERVER_USERNAME=nacos
NACOS_SERVER_PASSWORD=

# Docker Compose 自动读取 .env；直接启动 Java 服务时，需由 IDE 或 Shell 将变量注入进程。

# MySQL 容器与第一阶段共享的逻辑隔离数据库
MYSQL_ROOT_PASSWORD=media_root
MYSQL_DATABASE=media_platform
MYSQL_USER=media
MYSQL_PASSWORD=media

# 服务级数据库覆盖项。第一阶段须与 MYSQL_* 保持一致，物理拆库后再分别覆盖。
USER_DB_URL=jdbc:mysql://localhost:3306/media_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
USER_DB_USERNAME=media
USER_DB_PASSWORD=media
CONTENT_DB_URL=jdbc:mysql://localhost:3306/media_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
CONTENT_DB_USERNAME=media
CONTENT_DB_PASSWORD=media

# auth-service：仅认证服务访问 auth_account；生产环境请注入独立账号和密码。
AUTH_DB_URL=jdbc:mysql://localhost:3306/media_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
AUTH_DB_USERNAME=media
AUTH_DB_PASSWORD=media

# audit-service：仅审核服务访问 audit_*；第一阶段须与 MYSQL_* 保持一致。
AUDIT_DB_URL=jdbc:mysql://localhost:3306/media_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
AUDIT_DB_USERNAME=media
AUDIT_DB_PASSWORD=media

# transcode-service：仅转码服务访问 transcode_*；第一阶段须与 MYSQL_* 保持一致。
TRANSCODE_DB_URL=jdbc:mysql://localhost:3306/media_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
TRANSCODE_DB_USERNAME=media
TRANSCODE_DB_PASSWORD=media

# recommend-service：仅推荐服务访问 recommend_*；第一阶段须与 MYSQL_* 保持一致。
RECOMMEND_DB_URL=jdbc:mysql://localhost:3306/media_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
RECOMMEND_DB_USERNAME=media
RECOMMEND_DB_PASSWORD=media

# JWT 密钥必须由运行环境注入，禁止提交真实值；auth-service 启动时会校验其长度。
# 本地开发示例（请在实际使用时生成随机密钥）：使用至少 32 字符的随机字符串
AUTH_JWT_SECRET=local-dev-secret-please-change-in-production-min-32-chars
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=media-platform
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# RabbitMQ：此账户同时用于容器初始化和服务连接，修改时只改这一组变量。
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=media
RABBITMQ_PASSWORD=media

# Auth Outbox：关闭仅暂停发送，不停止事件入库；补齐任务默认关闭，需在明确范围内手工启用。
AUTH_OUTBOX_ENABLED=true
# 快速提示只提交 eventId，默认关闭；开启后仍由低频扫描保证恢复，修改需受控重启。
AUTH_OUTBOX_FAST_DISPATCH_ENABLED=false
AUTH_OUTBOX_FAST_DISPATCH_THREADS=2
AUTH_OUTBOX_FAST_DISPATCH_QUEUE_CAPACITY=256
AUTH_OUTBOX_BATCH_SIZE=100
AUTH_OUTBOX_MAX_ATTEMPTS=20
AUTH_OUTBOX_CONFIRM_TIMEOUT=5s
AUTH_OUTBOX_LEASE=30s
AUTH_OUTBOX_POLL_INTERVAL=1000
AUTH_OUTBOX_BACKLOG_REFRESH_INTERVAL=60000
AUTH_OUTBOX_SHUTDOWN_AWAIT=10s
AUTH_PROFILE_BACKFILL_ENABLED=false
AUTH_PROFILE_BACKFILL_DRY_RUN=true
AUTH_PROFILE_BACKFILL_BATCH_SIZE=100
AUTH_PROFILE_BACKFILL_POLL_INTERVAL=10000
USER_AVATAR_ALLOWED_PREFIX=

# User 消费：有限重试后进入持久死信队列，禁止无限立即 requeue。
USER_ACCOUNT_CREATED_CONSUMER_ENABLED=true
USER_ACCOUNT_CREATED_CONCURRENCY=1
USER_ACCOUNT_CREATED_MAX_ATTEMPTS=3

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gateway 认证拦截：验证结果缓存不应超过 Access Token 剩余寿命。
GATEWAY_AUTH_SERVICE_URL=lb://auth-service
GATEWAY_AUTH_CACHE_TTL=10m

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# file-service：file_* 表唯一由文件服务访问；密钥由本地安全注入，示例不提供默认值。
FILE_SERVER_PORT=8700
FILE_DB_URL=jdbc:mysql://localhost:3306/media_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
FILE_DB_USERNAME=media
FILE_DB_PASSWORD=
# 存储策略类型：ALIYUN_OSS（默认）或 MINIO
FILE_STORAGE_TYPE=ALIYUN_OSS
# 直传 V2 仍需完成隔离对象存储验收后再启用。
FILE_DIRECT_UPLOAD_V2_ENABLED=false
# 备选 MinIO 策略参数（仅在 FILE_STORAGE_TYPE=MINIO 时生效）
FILE_MINIO_ENDPOINT=http://localhost:9000
FILE_MINIO_PRESIGN_ENDPOINT=http://localhost:9000
FILE_MINIO_BUCKET=media-files-dev
FILE_MINIO_STAGING_PREFIX=staging
FILE_MINIO_PERMANENT_PREFIX=permanent
FILE_MINIO_ACCESS_KEY=
FILE_MINIO_SECRET_KEY=
FILE_MAX_SIZE=536870912
# Servlet 限额须大于文件上限以容纳 multipart 边界；应用仍按实际流字节核验。
FILE_MAX_MULTIPART_SIZE=200MB
FILE_MAX_REQUEST_SIZE=210MB
# 超过 2MB 的切片直接写入磁盘临时文件，防止大文件吃满 JVM 堆内存导致 OOM
FILE_MULTIPART_THRESHOLD=2MB
FILE_STREAM_BUFFER_SIZE=65536
FILE_STORAGE_CONNECT_TIMEOUT=3s
FILE_STORAGE_READ_TIMEOUT=15s
FILE_STORAGE_CALL_TIMEOUT=180s
FILE_PUT_TTL=15m
FILE_UPLOAD_TTL=30m
FILE_GET_TTL=2m
# 允许后端流式代理的最大字节数，默认 20MB (20971520字节)，超出拒绝代理以保护微服务带宽
FILE_PROXY_MAX_SIZE=20971520
FILE_CONFIRM_THREADS=2
FILE_CONFIRM_QUEUE_CAPACITY=16
FILE_CONFIRM_TASK_TIMEOUT=180s
# 默认不清理，只有隔离私有 bucket 经确认后才显式启用；@Scheduled 注解要求纯数字毫秒字符串。
FILE_CLEANUP_ENABLED=false
FILE_CLEANUP_INTERVAL=60000
FILE_CLEANUP_BATCH_SIZE=100
FILE_CLEANUP_MAX_BATCHES=5
FILE_CLEANUP_RUN_TIMEOUT=30s

# ==============================================================================
# 阿里云云服务配置 (Aliyun Cloud Services)：统一管理通用凭证、OSS 对象存储与 Green 内容安全
# ==============================================================================
# 1. 阿里云全局通用访问凭证（敏感信息，单 RAM 账号开发/测试时仅需在此填写一次）
# 若微服务需要独立权限隔离，可分别配置下方的 FILE_ALIYUN_OSS_ACCESS_KEY_ID 或 AUDIT_ALIYUN_ACCESS_KEY_ID
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# ------------------------------------------------------------------------------
# 2. 文件服务：阿里云 OSS 对象存储 (file-service)
# ------------------------------------------------------------------------------
# 阿里云 OSS 接入点与预签名端点配置（cell-cloud 存储桶，依靠路径 item/{item-name}/... 隔离多项目数据）
FILE_ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
FILE_ALIYUN_OSS_PRESIGN_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
FILE_ALIYUN_OSS_REGION=cn-beijing
FILE_ALIYUN_OSS_BUCKET=cell-cloud
# 存储桶内多项目/数据路径隔离前缀：item/{item-name}/...
FILE_ALIYUN_OSS_ITEM_NAME=media-platform
FILE_ALIYUN_OSS_ROOT_PREFIX=item/media-platform
FILE_ALIYUN_OSS_STAGING_PREFIX=staging
FILE_ALIYUN_OSS_PERMANENT_PREFIX=permanent
# 可选：文件服务专属 RAM 凭证（留空则自动继承上方 ALIYUN_ACCESS_KEY_ID / SECRET；同时兼容历史 FILE_OSS_ACCESS_KEY）
FILE_ALIYUN_OSS_ACCESS_KEY_ID=
FILE_ALIYUN_OSS_ACCESS_KEY_SECRET=

# ------------------------------------------------------------------------------
# 3. 审核服务：阿里云内容安全 2.0 增强版 (audit-service)
# ------------------------------------------------------------------------------
# 是否开启阿里云机审服务（默认 false：脱网或离线环境自动回退为本地规则测试桩）
AUDIT_ALIYUN_ENABLED=false
# 阿里云内容安全服务端点 Endpoint（默认：上海地域）
AUDIT_ALIYUN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
# 阿里云账号主 UID（用于 Webhook 异步回调 SHA-256 签名校验防篡改）
AUDIT_ALIYUN_UID=
# 异步机审 Webhook 回调通知公网 URL（云端生产经网关放行端点：如 https://api.example.com/api/audit/callback/aliyun/video；本地内网留空则走主动轮询）
AUDIT_ALIYUN_CALLBACK_URL=
# 异步机审 Webhook 回调签名防篡改加签种子 Seed
AUDIT_ALIYUN_CALLBACK_SEED=
# 图像/封面审查服务代码 (ServiceCode)，默认 baselineCheck 通用基线检测
AUDIT_ALIYUN_IMAGE_SERVICE=baselineCheck
# 视频流资产审查服务代码 (ServiceCode)，默认 videoDetection 视频合规检测
AUDIT_ALIYUN_VIDEO_SERVICE=videoDetection
# 本地模式下视频主动轮询最大超时时限（秒），默认 15 秒（超时自动优雅降级为 SUSPICIOUS 转人审）
AUDIT_ALIYUN_POLL_TIMEOUT_SECONDS=15
# 本地模式下视频主动轮询步长间隔（毫秒），默认 1500 毫秒
AUDIT_ALIYUN_POLL_INTERVAL_MILLIS=1500
# 云端回调模式下视频提交后的短时同步探测时限（秒），默认 3 秒（短视频快速出结果直接放行，超期挂起转 Webhook）
AUDIT_ALIYUN_SHORT_PROBE_TIMEOUT_SECONDS=3
# 可选：审核服务专属 RAM 凭证（留空则自动继承上方 ALIYUN_ACCESS_KEY_ID / SECRET）
AUDIT_ALIYUN_ACCESS_KEY_ID=
AUDIT_ALIYUN_ACCESS_KEY_SECRET=

# ==============================================================================
# transcode-service：视频多规格流媒体切片转码微服务
# ==============================================================================
# 引擎类型：ffmpeg（调用宿主机二进制）或 mock（脱网开发与自动化测试桩，默认 ffmpeg）
TRANSCODE_ENGINE_TYPE=ffmpeg
# 系统 ffmpeg 可执行文件路径
TRANSCODE_FFMPEG_PATH=ffmpeg
# 系统 ffprobe 可执行文件路径
TRANSCODE_FFPROBE_PATH=ffprobe
# 本地最大并发转码任务数限制（低配置硬件保护，默认 1）
TRANSCODE_MAX_CONCURRENT_TASKS=1
# 本地临时工作目录（转码中间文件存放与安全清理）
TRANSCODE_WORK_DIR=/tmp/calles-transcode
# 单个转码任务最大超时时限（秒，默认 600 秒）
TRANSCODE_TASK_TIMEOUT_SECONDS=600

# ==============================================================================
# recommend-service：推荐微服务（特征向量化、候选池库存与推荐分发）
# ==============================================================================
# 向量特征计算引擎：remote (远程模型，如 OpenAI) | local (纯本地哈希) | mock (测试桩)
RECOMMEND_EMBEDDING_TYPE=remote
# 远程异常或未配置 Key 时是否自动回退至本地算法保底
RECOMMEND_EMBEDDING_FALLBACK_TO_LOCAL=true
# 远程 Embedding 接口地址与模型
RECOMMEND_EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
RECOMMEND_EMBEDDING_OPENAI_API_KEY=
RECOMMEND_EMBEDDING_OPENAI_MODEL=text-embedding-3-small
RECOMMEND_EMBEDDING_OPENAI_DIMENSION=1536
RECOMMEND_EMBEDDING_OPENAI_TIMEOUT_MS=5000
# 本地特征哈希维度
RECOMMEND_EMBEDDING_LOCAL_DIMENSION=128

# Qdrant 向量数据库连接与集合
RECOMMEND_QDRANT_ENABLED=true
RECOMMEND_QDRANT_HOST=localhost
RECOMMEND_QDRANT_PORT=6333
RECOMMEND_QDRANT_API_KEY=
RECOMMEND_QDRANT_COLLECTION=video_vectors
RECOMMEND_QDRANT_TIMEOUT_MS=3000



