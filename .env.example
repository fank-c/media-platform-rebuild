# Nacos
NACOS_SERVER_ADDR=localhost:8848

# Docker Compose 自动读取 .env；直接启动 Java 服务时，需由 IDE 或 Shell 将变量注入进程。

# MySQL 容器与第一阶段共享的逻辑隔离数据库
MYSQL_ROOT_PASSWORD=media_root
MYSQL_DATABASE=media_platform
MYSQL_USER=media
MYSQL_PASSWORD=media

# 服务级数据库覆盖项。第一阶段须与 MYSQL_* 保持一致，物理拆库后再分别覆盖。
USER_DB_URL=jdbc:mysql://localhost:3306/media_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
USER_DB_USERNAME=media
USER_DB_PASSWORD=media
CONTENT_DB_URL=jdbc:mysql://localhost:3306/media_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
CONTENT_DB_USERNAME=media
CONTENT_DB_PASSWORD=media

# auth-service：仅认证服务访问 auth_account；生产环境请注入独立账号和密码。
AUTH_DB_URL=jdbc:mysql://localhost:3306/media_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
AUTH_DB_USERNAME=media
AUTH_DB_PASSWORD=media

# JWT 密钥必须由运行环境注入，禁止提交真实值；auth-service 启动时会校验其长度。
# 本地开发示例（请在实际使用时生成随机密钥）：使用至少 32 字符的随机字符串
AUTH_JWT_SECRET=local-dev-secret-please-change-in-production-min-32-chars
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=media-platform
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# RabbitMQ：此账户同时用于容器初始化和服务连接，修改时只改这一组变量。
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=media
RABBITMQ_PASSWORD=media

# Auth Outbox：关闭仅暂停发送，不停止事件入库；补齐任务默认关闭，需在明确范围内手工启用。
AUTH_OUTBOX_ENABLED=true
# 快速提示只提交 eventId，默认关闭；开启后仍由低频扫描保证恢复，修改需受控重启。
AUTH_OUTBOX_FAST_DISPATCH_ENABLED=false
AUTH_OUTBOX_FAST_DISPATCH_THREADS=2
AUTH_OUTBOX_FAST_DISPATCH_QUEUE_CAPACITY=256
AUTH_OUTBOX_BATCH_SIZE=100
AUTH_OUTBOX_MAX_ATTEMPTS=20
AUTH_OUTBOX_CONFIRM_TIMEOUT=5s
AUTH_OUTBOX_LEASE=30s
AUTH_OUTBOX_POLL_INTERVAL=1s
AUTH_OUTBOX_BACKLOG_REFRESH_INTERVAL=60s
AUTH_OUTBOX_SHUTDOWN_AWAIT=10s
AUTH_PROFILE_BACKFILL_ENABLED=false
AUTH_PROFILE_BACKFILL_DRY_RUN=true
AUTH_PROFILE_BACKFILL_BATCH_SIZE=100
AUTH_PROFILE_BACKFILL_POLL_INTERVAL=10s
USER_AVATAR_ALLOWED_PREFIX=

# User 消费：有限重试后进入持久死信队列，禁止无限立即 requeue。
USER_ACCOUNT_CREATED_CONSUMER_ENABLED=true
USER_ACCOUNT_CREATED_CONCURRENCY=1
USER_ACCOUNT_CREATED_MAX_ATTEMPTS=3

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gateway 认证拦截：验证结果缓存不应超过 Access Token 剩余寿命。
GATEWAY_AUTH_SERVICE_URL=lb://auth-service
GATEWAY_AUTH_CACHE_TTL=10m

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
